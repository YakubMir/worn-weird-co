<div class="product-page">
  <a class="back-link" href="{{ routes.collections_url }}">
    <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    Back to shop
  </a>

  <div class="product-layout">
    <div class="product-gallery">
      {% assign gallery_images = product.images %}
      <div class="gallery-main">
        {% if gallery_images.size > 1 %}
          <button class="gallery-arrow prev" type="button" aria-label="Previous image">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
        {% endif %}

        <div class="gallery-track">
          {% if gallery_images.size > 0 %}
            {% for image in gallery_images %}
              <div class="gallery-slide{% if forloop.first %} active{% endif %}">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  style="width:80%;height:auto;"
                />
              </div>
            {% endfor %}
          {% else %}
            <div class="gallery-slide active">
              <img
                src="{{ 'Worn_Weird_Logo_v2.png' | asset_url }}"
                alt="{{ product.title | escape }}"
              />
            </div>
          {% endif %}
        </div>

        {% if gallery_images.size > 1 %}
          <button class="gallery-arrow next" type="button" aria-label="Next image">
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        {% endif %}
      </div>

      {% if gallery_images.size > 1 %}
        <div class="gallery-dots">
          {% for image in gallery_images %}
            <button class="gallery-dot{% if forloop.first %} active{% endif %}" type="button" data-index="{{ forloop.index0 }}" aria-label="View {{ forloop.index }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-info">
      {% if product.type != blank %}
        <p class="eyebrow">{{ product.type }}</p>
      {% endif %}

      <h1>{{ product.title }}</h1>

      <div class="product-price">{{ product.price | money }}</div>

      {% if product.description != blank %}
        <div class="product-desc">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product %}
        {% unless product.has_only_default_variant %}
          {% capture variant_data %}[{% for variant in product.variants %}{"id":{{ variant.id }},"available":{{ variant.available }},"price":"{{ variant.price | money | strip_html | escape }}","options":{{ variant.options | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]{% endcapture %}

          <div class="variant-selector" data-variant-select data-variants="{{ variant_data | escape }}">
            {% for option in product.options_with_values %}
              <div class="option-group">
                <p class="option-label">{{ option.name }}</p>
                <div class="option-buttons" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <input
                      type="radio"
                      class="option-radio"
                      name="product-{{ product.id }}-option-{{ forloop.parentloop.index0 }}"
                      id="product-{{ product.id }}-option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                      value="{{ value | escape }}"
                      {% if value == option.selected_value %}checked{% endif %}
                    />
                    <label class="option-btn" for="product-{{ product.id }}-option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}">{{ value }}</label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id />
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
        {% endunless %}

        {% assign is_coming_soon = false %}
        {% for tag in product.tags %}
          {% if tag == 'coming-soon' %}{% assign is_coming_soon = true %}{% endif %}
        {% endfor %}

        {% unless product.available %}
          <div class="availability-notice sold-out">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <p>This item is currently <strong>sold out</strong>. We're working on a restock — follow us on <a href="https://instagram.com/worn_weird_co" target="_blank" rel="noreferrer">@worn_weird_co</a> to be first in line when it drops again.</p>
          </div>
        {% endunless %}

        {% if is_coming_soon and product.available %}
          <div class="availability-notice coming-soon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <p>This item <strong>hasn't dropped yet</strong>. Follow us on <a href="https://instagram.com/worn_weird_co" target="_blank" rel="noreferrer">@worn_weird_co</a> for the release announcement and drop date.</p>
          </div>
        {% endif %}

        <div class="product-actions">
          <button
            type="submit"
            name="add"
            class="add-to-bag"
            {% unless product.available %}disabled{% endunless %}
            {% if is_coming_soon and product.available %}disabled{% endif %}
          >
            {% if product.available %}
              {% if is_coming_soon %}Coming Soon{% else %}Add to Bag{% endif %}
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'variant-selector.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
