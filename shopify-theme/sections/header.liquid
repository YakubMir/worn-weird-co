<header class="site-header">
  <a class="brand-logo" href="{{ routes.root_url }}" style="text-decoration:none;color:inherit;">
    {% if section.settings.logo != blank %}
      <img
        src="{{ section.settings.logo | image_url: width: 120 }}"
        alt="{{ shop.name }}"
        width="54"
        height="54"
      />
    {% else %}
      <img
        src="{{ 'Worn_Weird_Logo_v2.png' | asset_url }}"
        alt="{{ shop.name }} logo"
        width="54"
        height="54"
      />
    {% endif %}
    <span>{{ shop.name }}</span>
  </a>
  <nav class="site-nav">
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>
  <a class="bag-button" href="{{ routes.cart_url }}" aria-label="View bag ({{ cart.item_count }} item{{ cart.item_count | pluralize }})">
    <svg viewBox="0 0 24 24"><path d="M6 7h12l-1.1 13.3a1 1 0 0 1-1 .9H8.1a1 1 0 0 1-1-.9L6 7z"/><path d="M9 7V6a3 3 0 0 1 6 0v1"/></svg>
    {% if cart.item_count > 0 %}
      <span class="bag-count">{{ cart.item_count }}</span>
    {% endif %}
  </a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    }
  ]
}
{% endschema %}
