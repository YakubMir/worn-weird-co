<div class="cart-page">
  <h1>Your Bag</h1>

  {% if cart.item_count > 0 %}
    {% form 'cart', cart %}
      <div class="cart-items">
        {% for item in cart.items %}
          <div class="cart-item">
            <div class="cart-item-image">
              {% if item.image %}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.image.alt | escape }}"
                />
              {% else %}
                <img
                  src="{{ 'Worn_Weird_Logo_v2.png' | asset_url }}"
                  alt="{{ item.product.title | escape }}"
                />
              {% endif %}
            </div>

            <div class="cart-item-info">
              <h3>{{ item.product.title }}</h3>
              {% unless item.variant.title == 'Default Title' %}
                <div class="cart-item-variant">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cart-item-qty">
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity for {{ item.product.title | escape }}"
                />
              </div>
            </div>

            <div class="cart-item-price">{{ item.line_price | money }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-footer">
        <div class="cart-subtotal">
          <span>Subtotal</span>{{ cart.total_price | money }}
        </div>
        <div class="cart-actions">
          <button type="submit" name="update" class="update-cart-btn">Update Bag</button>
          <button type="submit" name="checkout" class="checkout-btn">Checkout</button>
        </div>
      </div>
    {% endform %}
  {% else %}
    <div class="cart-empty">
      <h2>Your bag is empty</h2>
      <p>Looks like you haven't added anything yet. The weird stuff is waiting.</p>
      <a class="cta-button" href="{{ routes.collections_url }}">Shop Now</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
